DATABASE_URL=postgres://arbol:arbol@localhost:5432/arbol?sslmode=disable
PORT=8000
# Project id: "demo-arbol" with the emulator; the real one for the demo.
FIREBASE_PROJECT_ID=demo-arbol
# Remove this line to use the real Firebase project (needs GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FCEIA API used by the tutor and /api/schedule (default: the public one).
# FCEIA_API_BASE=https://fceia-api.ariloc.ar/api/v1
# OpenRouter key for the tutor; without it /api/chat answers 503.
OPENROUTER_API_KEY=
TUTOR_MODEL=anthropic/claude-sonnet-5.5
# Password of the demo students created by `arbol seed`.
DEMO_PASSWORD=arbol-demo
TUTOR_FALLBACK_MODELS=openai/gpt-6-astra,google/gemini-3.1-pro-preview
