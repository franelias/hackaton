# URL del backend (sin barra final). Sin esto, la app corre en modo demo con datos de prueba.
VITE_API_URL=
# Carrera de la demo (LCC)
# Config web del proyecto de Firebase (consola → Configuración del proyecto → Tus apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Solo para desarrollo con el emulador del backend (docker compose): localhost:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=
# 1 = forzar el modo demo aunque haya backend
VITE_MOCK=
